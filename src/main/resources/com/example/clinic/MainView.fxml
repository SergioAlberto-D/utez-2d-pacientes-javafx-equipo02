<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.clinic.controladores.PacienteController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="60.0" style="-fx-background-color: #0056b3;">
               <children>
                  <Label text="Directorio Clínico de Pacientes" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="80.0" spacing="80.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
               <children>
                  <VBox alignment="CENTER">
                     <children>
                        <Label text="Total de Pacientes" textFill="#6c757d">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblTotal" text="0" textFill="#343a40">
                           <font>
                              <Font name="System Bold" size="26.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER">
                     <children>
                        <Label text="Activos" textFill="#28a745">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblActivo" text="0" textFill="#28a745">
                           <font>
                              <Font name="System Bold" size="26.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER">
                     <children>
                        <Label text="Inactivos" textFill="#dc3545">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblInactivo" text="0" textFill="#dc3545">
                           <font>
                              <Font name="System Bold" size="26.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         <children>
            <TableView fx:id="tablaPacientes" VBox.vgrow="ALWAYS" style="-fx-border-color: #ced4da; -fx-border-radius: 5; -fx-background-radius: 5;">
               <columns>
                  <TableColumn fx:id="colCurp" prefWidth="150.0" style="-fx-alignment: CENTER;" text="CURP" />
                  <TableColumn fx:id="colNombre" prefWidth="220.0" text="NOMBRE COMPLETO" />
                  <TableColumn fx:id="colEdad" prefWidth="60.0" style="-fx-alignment: CENTER;" text="EDAD" />
                  <TableColumn fx:id="colTelefono" prefWidth="120.0" style="-fx-alignment: CENTER;" text="TELÉFONO" />
                  <TableColumn fx:id="colAlergias" prefWidth="190.0" text="ALERGIAS" />
                  <TableColumn fx:id="colEstatus" prefWidth="100.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;" text="ESTATUS" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#handleNuevo" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 18; -fx-cursor: hand;" text="+ Nuevo Paciente" />
            <Button mnemonicParsing="false" onAction="#Editarlo" style="-fx-background-color: #ffc107; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 18; -fx-cursor: hand;" text="✎ Editar" />
            <Button mnemonicParsing="false" onAction="#CambioEstatus" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 18; -fx-cursor: hand;" text="⇅ Cambiar Estatus" />
            <Button mnemonicParsing="false" onAction="#Eliminar" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 18; -fx-cursor: hand;" text="🗑 Eliminar" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblMsg" style="-fx-text-fill: #28a745; -fx-font-weight: bold; -fx-font-size: 14;" text="Cargando..." />
         </children>
      </HBox>
   </bottom>
</BorderPane>