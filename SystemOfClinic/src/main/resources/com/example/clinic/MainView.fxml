<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="627.0" prefWidth="972.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.clinic.controladores.PacienteController">
   <center>
      <HBox alignment="CENTER" prefHeight="478.0" prefWidth="807.0" BorderPane.alignment="CENTER">
         <children>
            <ScrollPane prefHeight="478.0" prefWidth="809.0">
               <content>
                  <TableView fx:id="tablaPacientes" prefHeight="471.0" prefWidth="793.0">
                    <columns>
                      <TableColumn fx:id="colCurp" prefWidth="161.0" text="CURP" />
                      <TableColumn fx:id="colNombre" prefWidth="150.0" text="NOMBRE" />
                        <TableColumn fx:id="colEdad" prefWidth="50.0" text="EDAD" />
                        <TableColumn fx:id="colTelefono" prefWidth="130.0" text="TELEFONO" />
                        <TableColumn fx:id="colAlergias" prefWidth="213.0" text="ALERGIAS" />
                        <TableColumn fx:id="colEstatus" prefWidth="78.0" text="ESTATUS" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </content>
            </ScrollPane>
         </children>
      </HBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="51.0" prefWidth="807.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleNuevo" text="Nuevo Paciente" textAlignment="CENTER" underline="true" />
            <Button mnemonicParsing="false" onAction="#Editarlo" text="Editar" textAlignment="CENTER" underline="true" />
            <Button mnemonicParsing="false" onAction="#CambioEstatus" text="Cambiar Estatus" textAlignment="CENTER" underline="true" />
            <Button mnemonicParsing="false" onAction="#Eliminar" text="Eliminar" textAlignment="CENTER" underline="true" />
            <HBox prefHeight="478.0" prefWidth="98.0" />
            <Label fx:id="lblMsg" prefHeight="44.0" prefWidth="181.0" text="Cargando......." />
         </children>
      </HBox>
   </bottom>
   <top>
      <HBox alignment="CENTER" prefHeight="98.0" prefWidth="807.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Total" />
                  <Label fx:id="lblTotal" style="-fx-font-size: 18;" text="0" />
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: green;" text="Activos" />
                  <Label fx:id="lblActivo" style="-fx-font-size: 18;" text="0" />
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: red;" text="Inactivos" />
                  <Label fx:id="lblInactivo" style="-fx-font-size: 18;" text="0" />
               </children>
            </VBox>
         </children>
      </HBox>
   </top>
</BorderPane>
